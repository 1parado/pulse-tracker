{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.4.0",
  "identifier": "app.paradox.pulse",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pulse",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3QzlFRDUxMDhDRThCOUUKUldTZWk4NElVZTNKZHpVQk9JZmwrdS9xVFdhTW1VTk5NQWRBWlJ1cGZlQUtIQ0ZlZEF5TVRyY0EK",
      "endpoints": [
        "https://github.com/1parado/pulse-tracker/releases/latest/download/latest.json"
      ]
    }
  }
}
